<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_default"
        android:background="@color/fondoClaro">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calculadora_titulo"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etNum1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_num1"
            android:inputType="numberDecimal|numberSigned"
            android:layout_marginBottom="@dimen/margin_small"/>

        <EditText
            android:id="@+id/etNum2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_num2"
            android:inputType="numberDecimal|numberSigned"
            android:layout_marginBottom="@dimen/margin_default"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2"
            android:layout_marginBottom="@dimen/margin_default">

            <ImageButton
                android:id="@+id/btnSuma"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:src="@drawable/ic_suma"
                android:contentDescription="@string/desc_suma"
                android:background="@android:color/white"/>

            <ImageButton
                android:id="@+id/btnResta"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:src="@drawable/ic_resta"
                android:contentDescription="@string/desc_resta"
                android:background="@android:color/white"/>

            <ImageButton
                android:id="@+id/btnMultiplicar"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:src="@drawable/ic_multiplicar"
                android:contentDescription="@string/desc_multiplicar"
                android:background="@android:color/white"/>

            <ImageButton
                android:id="@+id/btnDividir"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:src="@drawable/ic_dividir"
                android:contentDescription="@string/desc_dividir"
                android:background="@android:color/white"/>

            <ImageButton
                android:id="@+id/btnPotencia"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:src="@drawable/ic_potencia"
                android:contentDescription="@string/desc_potencia"
                android:background="@android:color/white"/>

            <ImageButton
                android:id="@+id/btnRaiz"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:src="@drawable/ic_raiz"
                android:contentDescription="@string/desc_raiz"
                android:background="@android:color/white"/>

        </GridLayout>

        <TextView
            android:id="@+id/tvResultadoCalc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="@dimen/margin_small"/>

        <Button
            android:id="@+id/btnVerHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_ver_historial"
            android:layout_marginTop="@dimen/margin_default"/>

        <Button
            android:id="@+id/btnRegresarCalc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_regresar"
            android:layout_marginTop="@dimen/margin_small"/>

    </LinearLayout>
</ScrollView>