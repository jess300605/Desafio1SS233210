<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_default"
        android:background="@color/fondoClaro">

        <TextView
            android:id="@+id/tvTituloSalario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/salario_titulo"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etNombreEmpleado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nombre_empleado"
            android:inputType="textPersonName"
            android:layout_marginBottom="@dimen/margin_small"/>

        <EditText
            android:id="@+id/etSalarioBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_salario_base"
            android:inputType="numberDecimal"
            android:layout_marginBottom="@dimen/margin_default"/>

        <Button
            android:id="@+id/btnCalcularSalario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_calcular_salario"
            android:layout_marginBottom="@dimen/margin_default"/>

        <TextView
            android:id="@+id/tvSalarioBruto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_normal"
            android:paddingBottom="4dp"/>

        <TextView
            android:id="@+id/tvRenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_normal"
            android:paddingBottom="4dp"/>

        <TextView
            android:id="@+id/tvAfp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_normal"
            android:paddingBottom="4dp"/>

        <TextView
            android:id="@+id/tvIsss"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_normal"
            android:paddingBottom="4dp"/>

        <TextView
            android:id="@+id/tvSalarioNeto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_title"
            android:textStyle="bold"
            android:paddingTop="8dp"/>

        <Button
            android:id="@+id/btnRegresarSalario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_regresar"
            android:layout_marginTop="@dimen/margin_default"/>

    </LinearLayout>
</ScrollView>